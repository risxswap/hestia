page {
  min-height: 100%;
  color: #27231f;
  background: #f7f3eb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 168rpx;
}

.card {
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 36rpx rgba(70, 56, 38, 0.08);
}

.muted {
  color: #71695d;
}
