.typed-collection-page,
.typed-hero,
.state-card,
.empty-card {
  display: flex;
  flex-direction: column;
}

.typed-collection-page {
  gap: 24rpx;
}

.typed-hero,
.state-card,
.empty-card {
  gap: 12rpx;
}

.state-card,
.empty-card {
  padding: 28rpx;
}

.eyebrow {
  color: #71695d;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  color: #27231f;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-title {
  color: #27231f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted {
  color: #71695d;
  font-size: 25rpx;
  line-height: 1.55;
}

.error-text {
  color: #8a3b2f;
  font-size: 25rpx;
  line-height: 1.5;
}
