<view class="page clothes-edit-page">
  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取衣服信息...</text>
  </view>
  <view wx:elif="{{errorMessage && !item}}" class="card state-card">
    <text class="error-text">{{errorMessage}}</text>
  </view>

  <block wx:if="{{item}}">
    <scroll-view class="edit-scroll" scroll-y="true">
      <view class="edit-scroll-content">
        <view class="field-group upload-field">
          <view class="upload-heading">
            <text class="field-label">上传图片</text>
            <button wx:if="{{canRecognizeImage}}" class="secondary-button upload-recognize-button" loading="{{imageRecognizing}}" bind:tap="handleRecognizeImageOverwrite">重新分析</button>
          </view>
          <t-upload
            files="{{imageFiles}}"
            max="{{6}}"
            mediaType="{{imageMediaType}}"
            gridConfig="{{imageGridConfig}}"
            sizeLimit="{{imageSizeLimit}}"
            bind:add="handleImageUpload"
            bind:success="handleImageUpload"
            bind:remove="handleImageRemove"
          />
          <text wx:if="{{imageUploadError}}" class="upload-error">{{imageUploadError}}</text>
          <text wx:if="{{imageRecognizing}}" class="muted">正在识别图片...</text>
          <text wx:if="{{imageRecognizeError}}" class="upload-error">{{imageRecognizeError}}</text>
        </view>

        <view class="form-grid">
          <label class="field-group field-group--full">
            <text class="field-label">名称</text>
            <input class="field" placeholder="例如：米白衬衫" value="{{draft.name}}" data-field="name" bindinput="handleDraftInput" />
          </label>
          <view class="field-group">
            <text class="field-label">分类</text>
            <view class="field-control">
              <input class="field field--with-trigger" placeholder="输入分类" value="{{draft.category}}" data-field="category" bindinput="handleDraftInput" />
              <button class="suggestion-trigger" data-field="category" bind:tap="handleSuggestionOpen">⌄</button>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">核心单品</text>
            <view class="radio-actions">
              <button class="radio-button {{draft.is_core ? 'radio-button--active' : ''}}" data-value="true" bind:tap="handleCoreToggle">是</button>
              <button class="radio-button {{!draft.is_core ? 'radio-button--active' : ''}}" data-value="false" bind:tap="handleCoreToggle">否</button>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">颜色</text>
            <view class="field-control">
              <input class="field field--with-trigger" placeholder="输入颜色" value="{{draft.color}}" data-field="color" bindinput="handleDraftInput" />
              <button class="suggestion-trigger" data-field="color" bind:tap="handleSuggestionOpen">⌄</button>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">廓形</text>
            <view class="field-control">
              <input class="field field--with-trigger" placeholder="输入廓形" value="{{draft.silhouette}}" data-field="silhouette" bindinput="handleDraftInput" />
              <button class="suggestion-trigger" data-field="silhouette" bind:tap="handleSuggestionOpen">⌄</button>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">材质</text>
            <view class="field-control">
              <input class="field field--with-trigger" placeholder="输入材质" value="{{draft.material}}" data-field="material" bindinput="handleDraftInput" />
              <button class="suggestion-trigger" data-field="material" bind:tap="handleSuggestionOpen">⌄</button>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">季节</text>
            <view class="field-control">
              <input class="field field--with-trigger" placeholder="输入季节" value="{{draft.season}}" data-field="season" bindinput="handleDraftInput" />
              <button class="suggestion-trigger" data-field="season" bind:tap="handleSuggestionOpen">⌄</button>
            </view>
          </view>
        </view>

        <label class="field-group">
          <text class="field-label">适用场景</text>
          <textarea class="textarea" maxlength="160" placeholder="例如：通勤，约会，周末" value="{{draft.sceneText}}" bindinput="handleSceneInput" />
        </label>

        <label class="field-group">
          <text class="field-label">备注</text>
          <textarea class="textarea" maxlength="220" placeholder="例如：肩线合适，但下摆需要扎进去" value="{{draft.user_notes}}" data-field="user_notes" bindinput="handleDraftInput" />
        </label>

        <view class="status-group">
          <text class="field-label">推荐状态</text>
          <view class="status-actions">
            <button class="status-button {{draft.recommendation_status === 'preferred' ? 'status-button--active' : ''}}" data-status="preferred" bind:tap="handleRecommendationStatus">优先推荐</button>
            <button class="status-button {{draft.recommendation_status === 'normal' ? 'status-button--active' : ''}}" data-status="normal" bind:tap="handleRecommendationStatus">正常推荐</button>
            <button class="status-button {{draft.recommendation_status === 'paused' ? 'status-button--active status-button--paused' : ''}}" data-status="paused" bind:tap="handleRecommendationStatus">暂不推荐</button>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="editor-actions edit-actions">
      <button class="secondary-button" bind:tap="handleBack">返回</button>
      <button class="primary-button save-button" loading="{{saving}}" bind:tap="handleSaveItem">保存</button>
    </view>
  </block>

  <view wx:if="{{activeSuggestionField}}" class="suggestion-sheet-backdrop" bind:tap="handleSuggestionClose"></view>
  <view wx:if="{{activeSuggestionField}}" class="suggestion-sheet">
    <view class="suggestion-sheet-header">
      <text class="suggestion-sheet-title">{{activeSuggestionTitle}}</text>
    </view>
    <scroll-view class="suggestion-sheet-scroll" scroll-y="true">
      <view class="suggestion-sheet-content">
        <button wx:for="{{activeSuggestionOptions}}" wx:key="value" class="suggestion-sheet-item" data-field="{{activeSuggestionField}}" data-value="{{item.value}}" bind:tap="handleSuggestionSelect">{{item.value}}</button>
      </view>
    </scroll-view>
  </view>
</view>
