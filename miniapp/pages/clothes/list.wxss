.clothes-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.clothes-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 8rpx;
}

.top-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.eyebrow {
  color: #71695d;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  color: #27231f;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-title {
  color: #27231f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted,
.empty-copy {
  color: #71695d;
  font-size: 25rpx;
  line-height: 1.55;
}

.clothes-filter-strip {
  width: 100%;
  white-space: nowrap;
}

.category-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.chip,
.primary-button,
.secondary-button,
.icon-button,
.status-button,
.danger-button,
.gallery-add-card,
.private-type-card,
.recent-private-card {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.25;
  white-space: normal;
  word-break: break-word;
}

.chip::after,
.primary-button::after,
.secondary-button::after,
.icon-button::after,
.status-button::after,
.danger-button::after,
.gallery-add-card::after,
.private-type-card::after,
.recent-private-card::after {
  border: 0;
}

.chip {
  flex: 0 0 auto;
  min-width: 120rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e6ded0;
  color: #71695d;
  background: #fffdf8;
}

.chip--active {
  border-color: #245d4f;
  color: #fffdf8;
  background: #245d4f;
  font-weight: 700;
}

.primary-button {
  min-height: 72rpx;
  color: #fffdf8;
  background: #245d4f;
}

.secondary-button {
  min-height: 72rpx;
  border: 1rpx solid #e6ded0;
  color: #27231f;
  background: #fffdf8;
}

.icon-button {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  color: #fffdf8;
  background: #245d4f;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1;
}

.state-card,
.empty-card,
.gaps-section {
  padding: 28rpx;
}

.state-card,
.empty-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.error-text {
  color: #8a3b2f;
  font-size: 25rpx;
  line-height: 1.5;
}

.empty-action {
  width: 240rpx;
}

.private-type-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.private-type-card {
  min-height: 180rpx;
  padding: 18rpx;
  align-items: stretch;
  justify-content: flex-start;
  flex-direction: row;
  gap: 16rpx;
  text-align: left;
  background: #fffdf8;
}

.private-type-card--disabled {
  opacity: 0.72;
}

.private-type-preview {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #e8e0d2;
}

.private-type-image {
  width: 100%;
  height: 100%;
}

.private-type-initial {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #245d4f;
  font-size: 24rpx;
  font-weight: 700;
}

.private-type-copy,
.subpage-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.private-type-title {
  color: #27231f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
}

.private-type-count,
.private-type-hint,
.recent-private-name {
  color: #71695d;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.recent-private-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-private-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.recent-private-card {
  min-width: 0;
  padding: 12rpx;
  align-items: stretch;
  flex-direction: column;
  gap: 10rpx;
  background: #fffdf8;
}

.recent-private-media {
  width: 100%;
  height: 142rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e8e0d2;
}

.recent-private-image,
.recent-private-placeholder {
  width: 100%;
  height: 100%;
}

.recent-private-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #71695d;
  font-size: 22rpx;
}

.subpage-heading {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.subpage-back {
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 20rpx;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.gallery-card {
  min-width: 0;
  overflow: hidden;
}

.gallery-media {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  background: #e8e0d2;
}

.gallery-image,
.gallery-placeholder {
  width: 100%;
  height: 100%;
}

.gallery-placeholder {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 8rpx;
  padding: 20rpx;
  background: #e8e0d2;
}

.placeholder-category {
  color: #71695d;
  font-size: 22rpx;
  font-weight: 700;
}

.placeholder-name {
  max-width: 100%;
  color: #27231f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-word;
}

.gallery-status {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  max-width: 176rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  color: #27231f;
  background: rgba(255, 253, 248, 0.92);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
}

.gallery-status--preferred {
  color: #fffdf8;
  background: rgba(36, 93, 79, 0.94);
}

.gallery-status--paused {
  color: #fffdf8;
  background: rgba(138, 59, 47, 0.92);
}

.gallery-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx;
}

.item-name {
  color: #27231f;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.item-meta {
  color: #71695d;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.gallery-add-card {
  min-height: 420rpx;
  padding: 28rpx 18rpx;
  border: 1rpx dashed #b7aa98;
  color: #27231f;
  background: #fffdf8;
  flex-direction: column;
  gap: 10rpx;
}

.gallery-add-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #fffdf8;
  background: #245d4f;
  font-size: 42rpx;
  line-height: 1;
}

.gallery-add-title {
  font-size: 27rpx;
  font-weight: 700;
}

.gallery-add-copy {
  color: #71695d;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.modal-layer {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(39, 35, 31, 0.42);
}

.modal-sheet {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: 28rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #fffaf1;
  box-shadow: 0 -18rpx 44rpx rgba(39, 35, 31, 0.16);
}

.type-picker-sheet {
  gap: 20rpx;
}

.type-picker-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.type-picker-option {
  min-height: 88rpx;
}

.modal-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e6ded0;
}

.modal-close {
  flex: 0 0 auto;
  min-width: 120rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
}

.modal-scroll {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-height: 62vh;
  padding: 24rpx 0;
}

.editor-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.field-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  color: #27231f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.field,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
  color: #27231f;
  background: #fffdf8;
  font-size: 25rpx;
}

.field {
  min-height: 72rpx;
  padding: 0 18rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 18rpx;
  line-height: 1.45;
}

.upload-field {
  padding: 18rpx;
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
  background: #fffdf8;
}

.upload-error {
  color: #8a3b2f;
  font-size: 23rpx;
  line-height: 1.4;
}

.status-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.status-button {
  min-height: 72rpx;
  padding: 0 10rpx;
  border: 1rpx solid #e6ded0;
  color: #71695d;
  background: #fffdf8;
  font-size: 23rpx;
}

.status-button--active {
  border-color: #245d4f;
  color: #fffdf8;
  background: #245d4f;
  font-weight: 700;
}

.status-button--paused {
  background: #71695d;
}

.core-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx;
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
}

.core-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.editor-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.modal-actions {
  padding-top: 20rpx;
  border-top: 1rpx solid #e6ded0;
  background: #fffaf1;
}

.editor-actions--single {
  grid-template-columns: minmax(0, 1fr);
}

.save-button {
  min-height: 76rpx;
}

.danger-button {
  min-height: 76rpx;
  border: 1rpx solid #e6ded0;
  color: #8a3b2f;
  background: #fffdf8;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gap-list {
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
}

.gap-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #e6ded0;
  color: #27231f;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}
