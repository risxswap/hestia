<view class="page typed-collection-page">
  <view class="typed-hero">
    <view class="typed-copy">
      <text class="eyebrow">私藏 / 发型</text>
      <text class="title">发型</text>
      <text class="muted">保存常用发型、想尝试的方向和不适合自己的整理方式。</text>
    </view>
    <button class="icon-button" bind:tap="handleOpenCreate">+</button>
  </view>

  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取发型...</text>
  </view>
  <view wx:elif="{{errorMessage && !modalVisible}}" class="card state-card">
    <text class="error-text">{{errorMessage}}</text>
  </view>
  <view wx:elif="{{!items.length}}" class="card empty-card">
    <text class="section-title">还没有发型私藏</text>
    <text class="muted">先记录一个常用长度或想尝试的方向，之后再进入编辑页补充细节。</text>
    <button class="primary-button action-button" bind:tap="handleOpenCreate">新增发型</button>
  </view>
  <view wx:else class="item-grid">
    <block wx:for="{{items}}" wx:key="public_id">
      <view class="card item-card" data-public-id="{{item.public_id}}" bind:tap="handleOpenDetail">
        <view class="item-media">
          <image wx:if="{{item.primaryImageSrc}}" class="item-image" src="{{item.primaryImageSrc}}" mode="aspectFill" />
          <text wx:else class="item-placeholder">发型</text>
        </view>
        <text class="item-title">{{item.name}}</text>
        <text class="muted">{{item.metaText}}</text>
      </view>
    </block>
  </view>

  <view wx:if="{{modalVisible}}" class="modal-layer">
    <view class="modal-backdrop" catchtap="handleCloseCreate"></view>
    <view class="modal-sheet">
      <view class="section-head">
        <text class="section-title">新增发型</text>
        <text class="muted">先保存名称和少量字段，完整信息进入编辑页完善。</text>
      </view>
      <label class="field-group">
        <text class="field-label">名称</text>
        <input class="field" value="{{draft.name}}" data-field="name" bindinput="handleInput" placeholder="例如：锁骨发" />
      </label>
      <label class="field-group">
        <text class="field-label">长度</text>
        <input class="field" value="{{draft.length}}" data-field="length" bindinput="handleInput" placeholder="例如：锁骨长度" />
      </label>
      <text wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</text>
      <view class="modal-actions">
        <button class="secondary-button action-button" bind:tap="handleCloseCreate">取消</button>
        <button class="primary-button action-button" loading="{{saving}}" bind:tap="handleSaveCreate">保存</button>
      </view>
    </view>
  </view>
</view>
