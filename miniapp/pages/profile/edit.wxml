<view class="page">
  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取档案...</text>
  </view>
  <view wx:elif="{{errorMessage && !draft.nickname}}" class="card state-card">
    <text class="error-text">{{errorMessage}}</text>
    <button class="primary-button action-button" bind:tap="loadProfile">重新读取</button>
  </view>
  <block wx:else>
    <view class="card edit-panel">
      <view class="section-head">
        <text class="section-title">基础档案</text>
        <text class="muted">只记录会影响穿搭、发型和场景建议的信息。</text>
      </view>
      <view class="form-grid">
        <label class="field-group">
          <text class="field-label">昵称</text>
          <input class="field" value="{{draft.nickname}}" data-field="nickname" bindinput="handleInput" placeholder="例如：明明" />
        </label>
        <view class="field-group">
          <text class="field-label">性别</text>
          <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="handleGenderChange">
            <view class="field picker-field">{{genderLabel}}</view>
          </picker>
        </view>
        <label class="field-group">
          <text class="field-label">身高 cm</text>
          <input class="field" type="number" value="{{draft.height_cm}}" data-field="height_cm" bindinput="handleInput" placeholder="例如：165" />
        </label>
        <label class="field-group">
          <text class="field-label">体重 kg</text>
          <input class="field" type="digit" value="{{draft.weight_kg}}" data-field="weight_kg" bindinput="handleInput" placeholder="可留空" />
        </label>
      </view>

      <view class="archive-section">
        <view class="section-head">
          <text class="section-title">照片档案</text>
          <text class="muted">每个观察项可上传固定照片位，也可以留下文字说明；不确定的内容可交给系统识别。</text>
        </view>
        <view class="photo-observations">
          <view wx:for="{{photoObservations}}" wx:key="key" wx:for-item="group" class="photo-observation">
            <view class="photo-observation-head">
              <text class="field-label">{{group.title}}</text>
            </view>
            <view class="photo-strip">
              <view wx:for="{{group.photos}}" wx:key="key" wx:for-item="slot" class="photo-strip-item">
                <image wx:if="{{slot.photo.url}}" class="photo-strip-image" src="{{slot.photo.url}}" mode="aspectFill" />
                <view wx:else class="photo-strip-image photo-strip-empty"><text>图片</text></view>
                <text class="photo-strip-label">{{slot.label}}</text>
                <button class="photo-delete photo-strip-delete" data-public-id="{{slot.photo.public_id}}" bind:tap="handleDeletePhoto">删除</button>
              </view>
              <button class="photo-add-tile" data-group-key="{{group.key}}" bind:tap="handleAddObservationPhoto">+</button>
            </view>
            <label class="field-group observation-note">
              <text class="field-label">{{group.noteLabel}}</text>
              <textarea class="textarea" maxlength="220" value="{{group.noteValue}}" data-field="{{group.noteField}}" bindinput="handleInput" placeholder="{{group.notePlaceholder}}" />
            </label>
          </view>
        </view>
        <text wx:if="{{imageUploading}}" class="muted">照片上传中...</text>
        <text wx:if="{{imageUploadError}}" class="save-message">{{imageUploadError}}</text>
      </view>
      <text wx:if="{{errorMessage}}" class="save-message">{{errorMessage}}</text>
      <button class="primary-button save-button" loading="{{saving}}" bind:tap="handleSave">保存基础档案</button>
    </view>
  </block>
</view>
