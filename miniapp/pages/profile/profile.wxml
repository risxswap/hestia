<view class="page">
  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取形象档案...</text>
  </view>

  <view wx:elif="{{loadErrorMessage}}" class="card state-card">
    <text class="section-title">档案读取失败</text>
    <text class="muted">{{loadErrorMessage}}</text>
    <button class="primary-button action-button" bind:tap="loadProfile">重新读取</button>
  </view>

  <block wx:else>
  <view class="profile-head">
    <view class="identity-copy">
      <text class="eyebrow">我的形象档案</text>
      <text class="title">{{user.nickname}}</text>
      <text class="muted">用户：{{user.user_public_id || "本地开发用户"}} · onboarding：{{user.onboarding_status || "未知"}}</text>
    </view>
    <button class="secondary-button small-button" bind:tap="handleStartOnboarding">补充档案</button>
  </view>

  <view class="card memory-card">
    <view class="section-head">
      <text class="section-title">长期记忆摘要</text>
      <text class="muted">这些信息会帮助后续建议更贴近你的真实场景，均可继续修正。</text>
    </view>
    <view class="memory-grid">
      <block wx:for="{{memoryItems}}" wx:key="label">
        <view class="memory-item">
          <text class="memory-value">{{item.value}}</text>
          <text class="memory-label">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="quick-grid">
    <block wx:for="{{quickEntries}}" wx:key="key">
      <button class="quick-entry {{activeSection === item.key ? 'quick-entry--active' : ''}}" data-key="{{item.key}}" bind:tap="handleQuickEntry">
        <text class="quick-title">{{item.title}}</text>
        <text class="quick-summary">{{item.summary}}</text>
        <text class="quick-action">{{item.action || "进入"}}</text>
      </button>
    </block>
  </view>

  <view id="profile-section" class="card edit-panel {{activeSection === 'profile' ? 'edit-panel--active' : ''}}">
    <view class="section-head">
      <text class="section-title">基础档案</text>
      <text class="muted">只记录会影响穿搭、发型和场景建议的信息。</text>
    </view>

    <view class="form-grid">
      <label class="field-group">
        <text class="field-label">昵称</text>
        <input class="field" value="{{profileDraft.nickname}}" data-field="nickname" bindinput="handleProfileInput" placeholder="例如：明明" />
      </label>
      <label class="field-group">
        <text class="field-label">性别表达</text>
        <input class="field" value="{{profileDraft.gender}}" data-field="gender" bindinput="handleProfileInput" placeholder="可留空或自定义" />
      </label>
      <label class="field-group">
        <text class="field-label">身高 cm</text>
        <input class="field" type="number" value="{{profileDraft.height_cm}}" data-field="height_cm" bindinput="handleProfileInput" placeholder="例如：165" />
      </label>
      <label class="field-group">
        <text class="field-label">常见场景</text>
        <input class="field" value="{{profileDraft.scenarioText}}" data-field="scenarioText" bindinput="handleProfileInput" placeholder="通勤、周末、约会" />
      </label>
    </view>

    <label class="field-group">
      <text class="field-label">身形/比例备注</text>
      <textarea class="textarea" maxlength="220" value="{{profileDraft.body_notes}}" data-field="body_notes" bindinput="handleProfileInput" placeholder="中性描述，例如：希望通勤更利落" />
    </label>
    <label class="field-group">
      <text class="field-label">肤色/妆发备注</text>
      <textarea class="textarea" maxlength="220" value="{{profileDraft.skin_notes}}" data-field="skin_notes" bindinput="handleProfileInput" placeholder="例如：偏好低饱和、自然气色" />
    </label>
    <label class="field-group">
      <text class="field-label">发型备注</text>
      <textarea class="textarea" maxlength="220" value="{{profileDraft.hair_notes}}" data-field="hair_notes" bindinput="handleProfileInput" placeholder="例如：希望好打理、适合通勤" />
    </label>

    <button class="primary-button save-button" loading="{{savingProfile}}" bind:tap="handleSaveProfile">保存基础档案</button>
    <text wx:if="{{profileSaveMessage}}" class="save-message">{{profileSaveMessage}}</text>
  </view>

  <view id="preferences-section" class="card edit-panel {{activeSection === 'preferences' ? 'edit-panel--active' : ''}}">
    <view class="section-head">
      <text class="section-title">偏好与禁忌</text>
      <text class="muted">用顿号、逗号或换行分隔。真实反馈会优先更新长期记忆。</text>
    </view>

    <label class="field-group">
      <text class="field-label">风格目标</text>
      <textarea class="textarea" maxlength="220" value="{{preferencesDraft.styleGoalsText}}" data-field="styleGoalsText" bindinput="handlePreferencesInput" placeholder="例如：更利落、自然、有亲和力" />
    </label>
    <label class="field-group">
      <text class="field-label">不想要的方向</text>
      <textarea class="textarea" maxlength="220" value="{{preferencesDraft.avoidancesText}}" data-field="avoidancesText" bindinput="handlePreferencesInput" placeholder="例如：过甜、太紧身、难打理" />
    </label>
    <label class="field-group">
      <text class="field-label">场景偏好</text>
      <textarea class="textarea" maxlength="220" value="{{preferencesDraft.scenarioPreferencesText}}" data-field="scenarioPreferencesText" bindinput="handlePreferencesInput" placeholder="例如：通勤更正式，周末更轻松" />
    </label>

    <button class="primary-button save-button" loading="{{savingPreferences}}" bind:tap="handleSavePreferences">保存偏好</button>
    <text wx:if="{{preferencesSaveMessage}}" class="save-message">{{preferencesSaveMessage}}</text>
  </view>

  <view id="privacy-section" class="card privacy-panel {{activeSection === 'privacy' ? 'privacy-panel--active' : ''}}">
    <view class="section-head">
      <text class="section-title">隐私与本地登录</text>
      <text class="muted">自拍、衣橱、偏好和反馈都属于敏感个人数据。服务端删除会在后续版本接入审核与确认流程。</text>
    </view>
    <button class="secondary-button action-button" bind:tap="handleClearLocalSession">清除本地登录</button>
    <button class="danger-button action-button" disabled="true">申请删除服务端档案（即将开放）</button>
  </view>
  </block>
</view>
