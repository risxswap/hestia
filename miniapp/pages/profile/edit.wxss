@import "./index.wxss";

.archive-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(25, 29, 36, 0.08);
}

.photo-groups {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.photo-group {
  padding: 18rpx;
  border: 1rpx solid rgba(25, 29, 36, 0.08);
  border-radius: 8rpx;
  background: #fbfaf7;
}

.photo-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.photo-add-button {
  min-width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.photo-item {
  width: 150rpx;
}

.photo-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #ebe7dd;
}

.photo-thumb--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #81786c;
  font-size: 24rpx;
}

.photo-meta {
  display: block;
  margin-top: 8rpx;
  color: #81786c;
  font-size: 22rpx;
}

.photo-delete {
  margin-top: 8rpx;
  padding: 0;
  height: 44rpx;
  line-height: 44rpx;
  color: #8f3f35;
  background: transparent;
  border: 0;
  font-size: 22rpx;
  text-align: left;
}
