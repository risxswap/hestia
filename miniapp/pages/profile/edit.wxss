@import "./index.wxss";

.archive-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(25, 29, 36, 0.08);
}

.picker-field {
  display: flex;
  align-items: center;
  color: #26221d;
}

.photo-observations {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.photo-observation {
  padding: 18rpx;
  border: 1rpx solid rgba(25, 29, 36, 0.08);
  border-radius: 8rpx;
  background: #fbfaf7;
}

.photo-observation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.photo-strip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.photo-strip-item {
  flex: 0 0 148rpx;
}

.photo-strip-image {
  width: 148rpx;
  height: 148rpx;
  border-radius: 8rpx;
  background: #ebe7dd;
}

.photo-strip-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #81786c;
  font-size: 24rpx;
  text-align: center;
}

.photo-strip-label {
  display: block;
  min-height: 34rpx;
  margin-top: 10rpx;
  color: #5f564d;
  font-size: 24rpx;
  line-height: 34rpx;
}

.photo-add-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 148rpx;
  width: 148rpx;
  height: 148rpx;
  margin: 0;
  padding: 0;
  border: 1rpx dashed rgba(25, 29, 36, 0.22);
  border-radius: 8rpx;
  background: #fffdfa;
  color: #81786c;
  font-size: 54rpx;
  line-height: 148rpx;
}

.photo-delete {
  padding: 0;
  height: 44rpx;
  line-height: 44rpx;
  color: #8f3f35;
  background: transparent;
  border: 0;
  font-size: 22rpx;
  text-align: left;
}

.photo-strip-delete {
  margin: 0;
}

.observation-note {
  margin-top: 18rpx;
}
