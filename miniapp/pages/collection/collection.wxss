.collection-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.collection-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-top: 8rpx;
}

.top-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.eyebrow {
  color: #71695d;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  color: #27231f;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-title {
  color: #27231f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted {
  color: #71695d;
  font-size: 25rpx;
  line-height: 1.55;
}

.state-card,
.empty-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
}

.error-text {
  color: #8a3b2f;
  font-size: 25rpx;
  line-height: 1.5;
}

.private-type-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.private-type-card,
.recent-private-card {
  display: flex;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.25;
  white-space: normal;
  word-break: break-word;
  background: #fffdf8;
}

.private-type-card::after,
.recent-private-card::after {
  border: 0;
}

.private-type-card {
  min-height: 180rpx;
  padding: 18rpx;
  flex-direction: row;
  gap: 16rpx;
  text-align: left;
}

.private-type-card--disabled {
  opacity: 0.72;
}

.private-type-preview {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #e8e0d2;
}

.private-type-initial {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #245d4f;
  font-size: 24rpx;
  font-weight: 700;
}

.private-type-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.private-type-title {
  color: #27231f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
}

.private-type-count,
.private-type-hint,
.recent-private-name {
  color: #71695d;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.recent-private-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recent-private-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.recent-private-card {
  min-width: 0;
  padding: 12rpx;
  flex-direction: column;
  gap: 10rpx;
}

.recent-private-media {
  width: 100%;
  height: 142rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e8e0d2;
}

.recent-private-image,
.recent-private-placeholder {
  width: 100%;
  height: 100%;
}

.recent-private-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #71695d;
  font-size: 22rpx;
}
