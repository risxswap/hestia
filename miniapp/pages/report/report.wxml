<view class="page">
  <view class="card report-head">
    <text class="muted">报告更新时间：{{updatedAt}}</text>
    <text class="title">你的下一步</text>
    <l-button type="primary">按这个生成明天搭配</l-button>
  </view>

  <view class="card list">
    <block wx:for="{{actionItems}}" wx:key="title">
      <view class="item">
        <text class="item-title">{{index + 1}}. {{item.title}}</text>
        <text class="muted">{{item.reason}}</text>
        <text class="avoid">{{item.avoid}}</text>
      </view>
    </block>
  </view>
</view>
