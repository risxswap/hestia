<view class="page">
  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取你的报告...</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="card state-card">
    <text class="title">{{empty ? "还没有初版报告" : "报告读取失败"}}</text>
    <text class="summary">{{empty ? "完成 onboarding 后，这里会展示服务端生成的初版个人形象报告。" : errorMessage}}</text>
    <button class="primary-button" bind:tap="loadLatestReport">{{empty ? "刷新报告" : "重新读取"}}</button>
  </view>

  <block wx:else>
  <view class="card report-head">
    <text wx:if="{{updatedAt}}" class="muted">报告更新时间：{{updatedAt}}</text>
    <text class="title">{{title}}</text>
    <text class="summary">{{summary}}</text>
    <text wx:if="{{referenceStyleLogic}}" class="muted">{{referenceStyleLogic}}</text>
  </view>

  <view class="card routes" wx:if="{{routes.length}}">
    <view class="section-head">
      <text class="section-label">形象路线</text>
      <text class="section-title">先明确适合你的表达方向</text>
    </view>

    <block wx:for="{{routes}}" wx:key="name">
      <view class="route-item">
        <view class="route-title-row">
          <text class="route-name">{{item.name}}</text>
          <text wx:if="{{item.roleLabel}}" class="route-role">{{item.roleLabel}}</text>
        </view>
        <text wx:if="{{item.impressionText}}" class="muted">目标印象：{{item.impressionText}}</text>
        <text class="route-reason">{{item.reasonText}}</text>
      </view>
    </block>
  </view>

  <view class="card list">
    <view class="section-head">
      <text class="section-label">行动项</text>
      <text class="section-title">下一步先做这些</text>
    </view>

    <block wx:for="{{actionItems}}" wx:key="title">
      <view class="item">
        <text class="item-title">{{index + 1}}. {{item.title}}</text>
        <text wx:if="{{item.reason}}" class="muted">{{item.reason}}</text>
        <text wx:if="{{item.avoid}}" class="avoid">{{item.avoid}}</text>
      </view>
    </block>
  </view>
  </block>
</view>
