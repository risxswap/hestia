.report-head {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.24;
}

.summary {
  color: #665d52;
  font-size: 28rpx;
  line-height: 1.68;
}

.routes {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.section-label {
  color: #a9783a;
  font-size: 23rpx;
  font-weight: 650;
}

.section-title {
  color: #27231f;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.35;
}

.route-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e6ded0;
}

.routes .section-head + .route-item {
  border-top: 0;
}

.route-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.route-name {
  min-width: 0;
  color: #27231f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.38;
}

.route-role {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #245d4f;
  background: #e8f0eb;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.3;
}

.route-reason {
  color: #665d52;
  font-size: 27rpx;
  line-height: 1.66;
}

.list {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 8rpx;
}

.item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e6ded0;
}

.list .section-head + .item {
  border-top: 0;
}

.item-title {
  color: #27231f;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.avoid {
  color: #a9783a;
  font-size: 26rpx;
  line-height: 1.55;
}

.primary-button {
  width: 100%;
  height: 76rpx;
  margin: 0;
  border-radius: 12rpx;
  color: #fffdf8;
  background: #245d4f;
  font-size: 28rpx;
  line-height: 76rpx;
}

.primary-button::after {
  border: 0;
}
