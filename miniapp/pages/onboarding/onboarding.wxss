.onboarding-page {
  padding-bottom: 40rpx;
}

.block,
.form-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
}

.title {
  color: #27231f;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-label {
  color: #a9783a;
  font-size: 23rpx;
  font-weight: 650;
}

.section-title {
  color: #27231f;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.35;
}

.form-card {
  margin-top: 24rpx;
}

.field,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #ded5c7;
  border-radius: 12rpx;
  color: #27231f;
  background: #fffdf8;
  font-size: 27rpx;
  line-height: 1.5;
}

.field {
  height: 78rpx;
  padding: 0 22rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 18rpx 22rpx;
}

.wardrobe-textarea {
  min-height: 220rpx;
}

.status-text,
.error-text {
  display: block;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.status-text {
  color: #245d4f;
  background: #e8f0eb;
}

.error-text {
  color: #8f3f2f;
  background: #f7e9e4;
}

.actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 76rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.primary-button {
  color: #fffdf8;
  background: #245d4f;
}

.secondary-button {
  color: #245d4f;
  background: #f1eadf;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}
