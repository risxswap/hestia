<view class="page wardrobe-detail-page">
  <view class="detail-nav">
    <button class="secondary-button nav-button" bind:tap="handleBack">返回衣橱</button>
    <view class="detail-nav-actions" wx:if="{{item}}">
      <button class="danger-button nav-button detail-delete-button" data-public-id="{{item.public_id}}" bind:tap="handleDeleteItem">删除</button>
      <button wx:if="{{!item.isRecognizing}}" class="primary-button nav-button" bind:tap="handleOpenEdit">编辑</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取衣服详情...</text>
  </view>
  <view wx:elif="{{errorMessage && !item}}" class="card state-card">
    <text class="error-text">{{errorMessage}}</text>
  </view>

  <block wx:if="{{item}}">
    <view class="detail-media card">
      <image wx:if="{{item.primaryImageSrc}}" class="detail-image" src="{{item.primaryImageSrc}}" mode="aspectFill" />
      <view wx:else class="detail-placeholder">
        <text class="placeholder-category">{{item.categoryLabel}}</text>
        <text class="placeholder-name">{{item.name}}</text>
      </view>
    </view>

    <view class="card info-card">
      <view class="info-heading">
        <view class="info-title-block">
          <text class="title">{{item.name}}</text>
          <text class="muted">{{item.metaText}}</text>
        </view>
        <text class="status-label {{item.isPreferred ? 'status-label--preferred' : ''}} {{item.isPaused ? 'status-label--paused' : ''}}">{{item.recommendationLabel}}</text>
      </view>
      <text wx:if="{{item.isRecognizing}}" class="muted">图片识别中，完成前暂不能编辑。</text>
      <view class="basic-line">
        <text wx:if="{{item.silhouette}}">廓形：{{item.silhouette}}</text>
        <text wx:if="{{item.material}}">材质：{{item.material}}</text>
        <text wx:if="{{item.season}}">季节：{{item.season}}</text>
      </view>
    </view>

    <view class="card section-card">
      <text class="section-title">搭配逻辑</text>
      <text class="section-copy">{{item.styleLogic}}</text>
    </view>

    <view class="card section-card">
      <text class="section-title">结构化档案</text>
      <view class="facts-grid">
        <view class="fact-item">
          <text class="fact-label">分类</text>
          <text class="fact-value">{{item.categoryLabel}}</text>
        </view>
        <view class="fact-item">
          <text class="fact-label">颜色</text>
          <text class="fact-value">{{item.colorText}}</text>
        </view>
        <view class="fact-item">
          <text class="fact-label">廓形</text>
          <text class="fact-value">{{item.silhouetteText}}</text>
        </view>
        <view class="fact-item">
          <text class="fact-label">材质</text>
          <text class="fact-value">{{item.materialText}}</text>
        </view>
        <view class="fact-item">
          <text class="fact-label">季节</text>
          <text class="fact-value">{{item.seasonText}}</text>
        </view>
        <view class="fact-item">
          <text class="fact-label">核心单品</text>
          <text class="fact-value">{{item.coreLabel}}</text>
        </view>
      </view>
      <view class="note-block">
        <text class="fact-label">场景标签</text>
        <text class="section-copy">{{item.sceneDisplayText}}</text>
      </view>
      <view class="note-block">
        <text class="fact-label">用户备注</text>
        <text class="section-copy">{{item.userNotesText}}</text>
      </view>
    </view>

    <view class="card section-card">
      <text class="section-title">最近反馈</text>
      <text class="section-copy">{{item.recentFeedbackText}}</text>
    </view>
  </block>

  <view wx:if="{{editorVisible}}" class="modal-layer">
    <view class="modal-backdrop" catchtap="handleCloseEditor"></view>
    <view class="modal-sheet">
      <view class="editor-header modal-header">
        <view>
          <text class="section-title">编辑单品</text>
          <text class="muted">修改后会继续影响后续搭配建议。</text>
        </view>
        <button class="secondary-button modal-close" bind:tap="handleCloseEditor">取消</button>
      </view>

      <scroll-view class="modal-scroll" scroll-y="true">
        <view class="form-grid">
          <label class="field-group">
            <text class="field-label">名称</text>
            <input class="field" placeholder="例如：米白衬衫" value="{{draft.name}}" data-field="name" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">分类</text>
            <input class="field" placeholder="top / bottom / outerwear" value="{{draft.category}}" data-field="category" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">颜色</text>
            <input class="field" placeholder="例如：米白、深蓝" value="{{draft.color}}" data-field="color" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">廓形</text>
            <input class="field" placeholder="例如：微宽松、直筒" value="{{draft.silhouette}}" data-field="silhouette" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">材质</text>
            <input class="field" placeholder="例如：棉、羊毛、牛仔" value="{{draft.material}}" data-field="material" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">季节</text>
            <input class="field" placeholder="例如：春秋、四季" value="{{draft.season}}" data-field="season" bindinput="handleDraftInput" />
          </label>
        </view>

        <view class="field-group upload-field">
          <text class="field-label">上传图片</text>
          <t-upload
            files="{{imageFiles}}"
            max="{{1}}"
            mediaType="{{imageMediaType}}"
            gridConfig="{{imageGridConfig}}"
            sizeLimit="{{imageSizeLimit}}"
            bind:add="handleImageUpload"
            bind:success="handleImageUpload"
            bind:remove="handleImageRemove"
          />
          <text wx:if="{{imageUploadError}}" class="upload-error">{{imageUploadError}}</text>
          <view class="upload-actions" wx:if="{{canRecognizeImage}}">
            <button class="secondary-button" loading="{{imageRecognizing}}" bind:tap="handleRecognizeImageOverwrite">重新识别</button>
          </view>
          <text wx:if="{{imageRecognizing}}" class="muted">正在识别图片...</text>
          <text wx:if="{{imageRecognizeError}}" class="upload-error">{{imageRecognizeError}}</text>
        </view>

        <label class="field-group">
          <text class="field-label">适用场景</text>
          <textarea class="textarea" maxlength="160" placeholder="例如：通勤，约会，周末" value="{{draft.sceneText}}" bindinput="handleSceneInput" />
        </label>

        <label class="field-group">
          <text class="field-label">备注</text>
          <textarea class="textarea" maxlength="220" placeholder="例如：肩线合适，但下摆需要扎进去" value="{{draft.user_notes}}" data-field="user_notes" bindinput="handleDraftInput" />
        </label>

        <view class="status-group">
          <text class="field-label">推荐状态</text>
          <view class="status-actions">
            <button class="status-button {{draft.recommendation_status === 'preferred' ? 'status-button--active' : ''}}" data-status="preferred" bind:tap="handleRecommendationStatus">优先推荐</button>
            <button class="status-button {{draft.recommendation_status === 'normal' ? 'status-button--active' : ''}}" data-status="normal" bind:tap="handleRecommendationStatus">正常推荐</button>
            <button class="status-button {{draft.recommendation_status === 'paused' ? 'status-button--active status-button--paused' : ''}}" data-status="paused" bind:tap="handleRecommendationStatus">暂不推荐</button>
          </view>
        </view>

        <view class="core-row">
          <view class="core-copy">
            <text class="field-label">核心单品</text>
            <text class="muted">开启后会更常进入每日建议。</text>
          </view>
          <switch checked="{{draft.is_core}}" bindchange="handleCoreToggle" color="#27231f" />
        </view>
      </scroll-view>

      <view class="editor-actions modal-actions">
        <button class="danger-button" data-public-id="{{editingPublicID}}" bind:tap="handleDeleteItem">删除</button>
        <button class="primary-button save-button" loading="{{saving}}" bind:tap="handleSaveItem">保存</button>
      </view>
    </view>
  </view>
</view>
