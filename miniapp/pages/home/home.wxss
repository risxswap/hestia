.home-page {
  min-height: calc(100vh - 64rpx);
}

.home-head {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.list {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}

.item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e6ded0;
}

.item:first-child {
  border-top: 0;
}

.item-title {
  font-weight: 700;
}

.avoid {
  color: #a9783a;
}

.primary-button {
  width: 100%;
  height: 76rpx;
  margin: 0;
  border-radius: 12rpx;
  color: #fffdf8;
  background: #245d4f;
  font-size: 28rpx;
  line-height: 76rpx;
}

.primary-button::after {
  border: 0;
}
