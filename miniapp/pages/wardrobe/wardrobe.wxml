<view class="page wardrobe-page">
  <view class="wardrobe-hero">
    <view class="top-copy">
      <text class="eyebrow">个人长期记忆</text>
      <text class="title">我的衣服</text>
      <text class="muted">当前展示 {{visibleItems.length}} 件，共 {{items.length}} 件。它们会参与后续每日穿搭、发型和场景建议。</text>
    </view>
    <button class="icon-button add-button" aria-label="新增衣服" bind:tap="handleOpenCreate">+</button>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" enable-flex="true">
    <view class="category-row">
      <block wx:for="{{categoryOptions}}" wx:key="value">
        <button
          class="chip {{activeCategory === item.value ? 'chip--active' : ''}}"
          data-category="{{item.value}}"
          bind:tap="handleCategoryFilter"
        >
          {{item.countLabel}}
        </button>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取衣橱...</text>
  </view>
  <view wx:elif="{{errorMessage}}" class="card state-card">
    <text class="error-text">{{errorMessage}}</text>
  </view>

  <view wx:if="{{!loading && !errorMessage && !items.length}}" class="card empty-card">
    <text class="section-title">先添加一件常穿衣服</text>
    <text class="muted">从最稳定、最常穿的一件开始即可，让后续建议更贴近真实生活。</text>
    <button class="primary-button empty-action" bind:tap="handleOpenCreate">新增衣服</button>
  </view>

  <view wx:elif="{{!loading && !errorMessage && items.length && !visibleItems.length}}" class="card empty-card">
    <text class="section-title">这个分类还没有衣服</text>
    <text class="muted">可以先补一件真实会穿的单品，不需要完整盘点衣橱。</text>
    <button class="secondary-button empty-action" bind:tap="handleOpenCreate">新增这类衣服</button>
  </view>

  <view wx:if="{{!loading && !errorMessage && visibleItems.length}}" class="gallery-grid">
    <block wx:for="{{visibleItems}}" wx:key="public_id">
      <view class="card gallery-card" data-public-id="{{item.public_id}}" bind:tap="handleOpenDetail">
        <view class="gallery-media">
          <image wx:if="{{item.primaryImageSrc}}" class="gallery-image" src="{{item.primaryImageSrc}}" mode="aspectFill" />
          <view wx:else class="gallery-placeholder">
            <text class="placeholder-category">{{item.categoryLabel}}</text>
            <text class="placeholder-name">{{item.name}}</text>
          </view>
          <text class="gallery-status {{item.isPreferred ? 'gallery-status--preferred' : ''}} {{item.isPaused ? 'gallery-status--paused' : ''}}">{{item.keyStatus}}</text>
        </view>
        <view class="gallery-body">
          <text class="item-name">{{item.name}}</text>
          <text class="item-meta">{{item.metaText}}</text>
        </view>
      </view>
    </block>

    <button class="gallery-add-card" bind:tap="handleOpenCreate">
      <text class="gallery-add-plus">+</text>
      <text class="gallery-add-title">新增衣服</text>
      <text class="gallery-add-copy">记录会影响建议的关键信息</text>
    </button>
  </view>

  <view wx:if="{{editorVisible}}" class="modal-layer">
    <view class="modal-backdrop" catchtap="handleCloseEditor"></view>
    <view class="modal-sheet">
      <view class="editor-header modal-header">
        <view>
          <text class="section-title">{{editingPublicID ? '编辑单品' : '新增单品'}}</text>
          <text class="muted">只记录会影响建议的关键信息，不需要完整盘点衣橱。</text>
        </view>
        <button class="secondary-button modal-close" bind:tap="handleCloseEditor">取消</button>
      </view>

      <scroll-view class="modal-scroll" scroll-y="true">
        <view class="form-grid">
          <label class="field-group">
            <text class="field-label">名称</text>
            <input class="field" placeholder="例如：米白衬衫" value="{{draft.name}}" data-field="name" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">分类</text>
            <input class="field" placeholder="top / bottom / outerwear" value="{{draft.category}}" data-field="category" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">颜色</text>
            <input class="field" placeholder="例如：米白、深蓝" value="{{draft.color}}" data-field="color" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">廓形</text>
            <input class="field" placeholder="例如：微宽松、直筒" value="{{draft.silhouette}}" data-field="silhouette" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">材质</text>
            <input class="field" placeholder="例如：棉、羊毛、牛仔" value="{{draft.material}}" data-field="material" bindinput="handleDraftInput" />
          </label>
          <label class="field-group">
            <text class="field-label">季节</text>
            <input class="field" placeholder="例如：春秋、四季" value="{{draft.season}}" data-field="season" bindinput="handleDraftInput" />
          </label>
        </view>

        <view class="field-group upload-field">
          <text class="field-label">主图</text>
          <t-upload
            files="{{imageFiles}}"
            max="{{1}}"
            mediaType="{{imageMediaType}}"
            gridConfig="{{imageGridConfig}}"
            sizeLimit="{{imageSizeLimit}}"
            bind:add="handleImageUpload"
            bind:success="handleImageUpload"
            bind:remove="handleImageRemove"
          />
          <text wx:if="{{imageUploadError}}" class="upload-error">{{imageUploadError}}</text>
        </view>

        <label class="field-group">
          <text class="field-label">适用场景</text>
          <textarea class="textarea" maxlength="160" placeholder="例如：通勤，约会，周末" value="{{draft.sceneText}}" bindinput="handleSceneInput" />
        </label>

        <label class="field-group">
          <text class="field-label">备注</text>
          <textarea class="textarea" maxlength="220" placeholder="例如：肩线合适，但下摆需要扎进去" value="{{draft.user_notes}}" data-field="user_notes" bindinput="handleDraftInput" />
        </label>

        <view class="status-group">
          <text class="field-label">推荐状态</text>
          <view class="status-actions">
            <button class="status-button {{draft.recommendation_status === 'preferred' ? 'status-button--active' : ''}}" data-status="preferred" bind:tap="handleRecommendationStatus">优先推荐</button>
            <button class="status-button {{draft.recommendation_status === 'normal' ? 'status-button--active' : ''}}" data-status="normal" bind:tap="handleRecommendationStatus">正常推荐</button>
            <button class="status-button {{draft.recommendation_status === 'paused' ? 'status-button--active status-button--paused' : ''}}" data-status="paused" bind:tap="handleRecommendationStatus">暂不推荐</button>
          </view>
        </view>

        <view class="core-row">
          <view class="core-copy">
            <text class="field-label">核心单品</text>
            <text class="muted">开启后会更常进入每日建议。</text>
          </view>
          <switch checked="{{draft.is_core}}" bindchange="handleCoreToggle" color="#27231f" />
        </view>
      </scroll-view>

      <view class="editor-actions modal-actions {{editingPublicID ? '' : 'editor-actions--single'}}">
        <button wx:if="{{editingPublicID}}" class="danger-button" data-public-id="{{editingPublicID}}" bind:tap="handleDeleteItem">删除</button>
        <button class="primary-button save-button" loading="{{saving}}" bind:tap="handleSaveItem">保存</button>
      </view>
    </view>
  </view>

  <view class="card gaps-section">
    <view class="section-heading">
      <text class="section-title">建议补齐</text>
      <text class="muted">这些是报告里的缺口方向，仅作为搭配结构参考，不提供商品链接。</text>
    </view>
    <view wx:if="{{gaps.length}}" class="gap-list">
      <block wx:for="{{gaps}}" wx:key="*this">
        <text class="gap-item">{{item}}</text>
      </block>
    </view>
    <text wx:else class="empty-copy">暂无明确缺口。后续报告和反馈会继续更新。</text>
  </view>
</view>
