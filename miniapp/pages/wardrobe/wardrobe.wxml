<view class="page wardrobe-page">
  <view class="wardrobe-hero">
    <view class="top-copy">
      <text class="eyebrow">私藏 / 衣服</text>
      <text class="title">衣服</text>
      <text class="muted">管理会参与建议的常穿单品。已收录 {{items.length}} 件。</text>
    </view>
    <button class="icon-button add-button" aria-label="新增衣服" bind:tap="handleOpenCreate">+</button>
  </view>

  <view wx:if="{{loading}}" class="card state-card">
    <text class="muted">正在读取衣服...</text>
  </view>
  <view wx:elif="{{errorMessage}}" class="card state-card">
    <text class="error-text">{{errorMessage}}</text>
  </view>

  <block wx:else>
    <scroll-view class="clothes-filter-strip" scroll-x="true" enable-flex="true">
      <view class="category-row">
        <block wx:for="{{categoryOptions}}" wx:key="value">
          <button
            class="chip {{activeCategory === item.value ? 'chip--active' : ''}}"
            data-category="{{item.value}}"
            bind:tap="handleCategoryFilter"
          >
            {{item.countLabel}}
          </button>
        </block>
      </view>
    </scroll-view>

    <view wx:if="{{items.length && !visibleItems.length}}" class="card empty-card">
      <text class="section-title">这个分类还没有衣服</text>
      <text class="muted">可以先补一件真实会用的单品，不需要一次性完整盘点。</text>
      <button class="secondary-button empty-action" bind:tap="handleOpenCreate">新增衣服</button>
    </view>

    <view wx:if="{{visibleItems.length}}" class="gallery-grid">
      <block wx:for="{{visibleItems}}" wx:key="public_id">
        <view class="card gallery-card" data-public-id="{{item.public_id}}" bind:tap="handleOpenDetail">
          <view class="gallery-media">
            <image wx:if="{{item.primaryImageSrc}}" class="gallery-image" src="{{item.primaryImageSrc}}" mode="aspectFill" />
            <view wx:else class="gallery-placeholder">
              <text class="placeholder-category">{{item.categoryLabel}}</text>
              <text class="placeholder-name">{{item.name}}</text>
            </view>
            <text class="gallery-status {{item.isPreferred ? 'gallery-status--preferred' : ''}} {{item.isPaused ? 'gallery-status--paused' : ''}}">{{item.keyStatus}}</text>
          </view>
          <view class="gallery-body">
            <text class="item-name">{{item.name}}</text>
            <text class="item-meta">{{item.metaText}}</text>
          </view>
        </view>
      </block>

      <button class="gallery-add-card" bind:tap="handleOpenCreate">
        <text class="gallery-add-plus">+</text>
        <text class="gallery-add-title">新增衣服</text>
        <text class="gallery-add-copy">记录会影响建议的关键信息</text>
      </button>
    </view>

    <view wx:if="{{!items.length}}" class="card empty-card">
      <text class="section-title">先添加一件常穿衣服</text>
      <text class="muted">从真实会穿的一件开始即可，不需要一次性完整盘点。</text>
      <button class="primary-button empty-action" bind:tap="handleOpenCreate">新增衣服</button>
    </view>

    <view class="card gaps-section">
      <view class="section-heading">
        <text class="section-title">建议补齐</text>
        <text class="muted">这些是报告里的缺口方向，仅作为搭配结构参考，不提供商品链接。</text>
      </view>
      <view wx:if="{{gaps.length}}" class="gap-list">
        <block wx:for="{{gaps}}" wx:key="*this">
          <text class="gap-item">{{item}}</text>
        </block>
      </view>
      <text wx:else class="empty-copy">暂无明确缺口。后续报告和反馈会继续更新。</text>
    </view>
  </block>

  <view wx:if="{{editorVisible}}" class="modal-layer">
    <view class="modal-backdrop" catchtap="handleCloseEditor"></view>
    <view class="modal-sheet">
      <view class="editor-header modal-header">
        <view>
          <text class="section-title">新增衣服</text>
          <text class="muted">上传一张清晰照片即可，系统会自动识别并记录。</text>
        </view>
        <button class="secondary-button modal-close" bind:tap="handleCloseEditor">取消</button>
      </view>

      <scroll-view class="modal-scroll" scroll-y="true">
        <view class="field-group upload-field">
          <text class="field-label">上传图片</text>
          <t-upload
            files="{{imageFiles}}"
            max="{{6}}"
            mediaType="{{imageMediaType}}"
            gridConfig="{{imageGridConfig}}"
            sizeLimit="{{imageSizeLimit}}"
            bind:add="handleImageUpload"
            bind:success="handleImageUpload"
            bind:remove="handleImageRemove"
          />
          <text wx:if="{{imageRecognizing}}" class="muted">正在识别图片并回填表单...</text>
          <text wx:if="{{imageUploadError}}" class="upload-error">{{imageUploadError}}</text>
          <text wx:if="{{imageRecognizeError}}" class="upload-error">{{imageRecognizeError}}</text>
        </view>
      </scroll-view>

      <view class="editor-actions modal-actions editor-actions--single">
        <button class="primary-button save-button" loading="{{saving}}" bind:tap="handleSaveItem">保存</button>
      </view>
    </view>
  </view>
</view>
