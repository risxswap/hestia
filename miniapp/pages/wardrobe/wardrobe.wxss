.wardrobe-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wardrobe-top,
.state-card,
.empty-card,
.editor-panel,
.gaps-section {
  padding: 28rpx;
}

.top-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.top-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.eyebrow {
  color: #71695d;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  color: #27231f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-title {
  color: #27231f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.muted,
.empty-copy {
  color: #71695d;
  font-size: 25rpx;
  line-height: 1.55;
}

.priority-summary {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e6ded0;
}

.priority-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.priority-pill {
  max-width: 100%;
  padding: 12rpx 16rpx;
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
  background: #fffdf8;
}

.priority-name,
.priority-meta {
  display: block;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.priority-name {
  color: #27231f;
  font-size: 25rpx;
  font-weight: 600;
}

.priority-meta {
  margin-top: 2rpx;
  color: #71695d;
  font-size: 21rpx;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
  white-space: nowrap;
}

.chip,
.primary-button,
.secondary-button,
.link-button,
.status-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.25;
  white-space: normal;
  word-break: break-word;
}

.chip::after,
.primary-button::after,
.secondary-button::after,
.link-button::after,
.status-button::after,
.danger-button::after {
  border: 0;
}

.chip {
  flex: 0 0 auto;
  min-width: 104rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e6ded0;
  color: #71695d;
  background: #fffdf8;
}

.chip--active {
  border-color: #27231f;
  color: #fffdf8;
  background: #27231f;
  font-weight: 700;
}

.primary-button {
  color: #fffdf8;
  background: #27231f;
}

.secondary-button {
  border: 1rpx solid #e6ded0;
  color: #27231f;
  background: #fffdf8;
}

.add-button {
  flex: 0 0 132rpx;
}

.state-card,
.empty-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.error-text {
  color: #8a3b2f;
  font-size: 25rpx;
  line-height: 1.5;
}

.empty-action {
  width: 240rpx;
}

.item-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.item-card {
  min-width: 0;
  overflow: hidden;
}

.item-image,
.item-placeholder {
  width: 100%;
  height: 208rpx;
  background: #e6ded0;
}

.item-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  color: #71695d;
  font-size: 24rpx;
  text-align: center;
}

.item-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx;
}

.item-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-name {
  color: #27231f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.status-label {
  align-self: flex-start;
  max-width: 100%;
  padding: 6rpx 10rpx;
  border: 1rpx solid #e6ded0;
  border-radius: 8rpx;
  color: #71695d;
  background: #fffdf8;
  font-size: 21rpx;
  line-height: 1.25;
}

.status-label--preferred {
  border-color: #27231f;
  color: #27231f;
  font-weight: 700;
}

.status-label--paused {
  color: #8a3b2f;
}

.item-meta,
.item-line {
  color: #71695d;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.link-button {
  align-self: flex-start;
  min-height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e6ded0;
  color: #27231f;
  background: #fffdf8;
  font-size: 23rpx;
}

.editor-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.editor-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.field-group {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  color: #27231f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.field,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
  color: #27231f;
  background: #fffdf8;
  font-size: 25rpx;
}

.field {
  min-height: 72rpx;
  padding: 0 18rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 18rpx;
  line-height: 1.45;
}

.status-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.status-button {
  min-height: 72rpx;
  padding: 0 10rpx;
  border: 1rpx solid #e6ded0;
  color: #71695d;
  background: #fffdf8;
  font-size: 23rpx;
}

.status-button--active {
  border-color: #27231f;
  color: #fffdf8;
  background: #27231f;
  font-weight: 700;
}

.status-button--paused {
  background: #71695d;
}

.core-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx;
  border: 1rpx solid #e6ded0;
  border-radius: 12rpx;
}

.core-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.editor-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.editor-actions--single {
  grid-template-columns: minmax(0, 1fr);
}

.save-button {
  min-height: 76rpx;
}

.danger-button {
  min-height: 76rpx;
  border: 1rpx solid #e6ded0;
  color: #8a3b2f;
  background: #fffdf8;
}

.section-heading {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gap-list {
  display: flex;
  flex-direction: column;
  margin-top: 18rpx;
}

.gap-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #e6ded0;
  color: #27231f;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}
