.advisor-page {
  min-height: calc(100vh - 64rpx);
  padding: 0;
}

.advisor-chat {
  --td-brand-color: #245d4f;
  --td-primary-color-7: #245d4f;
  --td-text-color-primary: #232323;
  --td-text-color-secondary: #62605a;
  --td-text-color-placeholder: #8b8983;
  --td-bg-color-container: #ffffff;
  --td-bg-color-secondarycontainer: #eef3f1;
  --td-bg-color-specialcomponent: #ffffff;
  --td-component-border: #d7ddd9;
  --td-radius-extraLarge: 18rpx;
  --td-radius-default: 10rpx;

  position: relative;
  display: flex;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: #f6f8f7;
}

.advisor-chat__list {
  flex: 1;
  min-height: 0;
}

.advisor-chat__content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 28rpx 24rpx 34rpx;
}

.chat-message {
  display: flex;
  margin-bottom: 28rpx;
  flex-direction: column;
  align-items: flex-start;
}

.chat-message--user {
  align-items: flex-end;
}

.chat-message__meta {
  height: 34rpx;
  margin-bottom: 8rpx;
  color: #74726d;
  font-size: 23rpx;
  line-height: 34rpx;
}

.chat-message__bubble {
  box-sizing: border-box;
  max-width: 600rpx;
  min-height: 70rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #dfe5e2;
  border-radius: 6rpx 20rpx 20rpx 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(32, 43, 39, 0.07);
}

.agent-process {
  box-sizing: border-box;
  width: 100%;
  max-width: 600rpx;
  margin-bottom: 12rpx;
}

.agent-process__summary {
  box-sizing: border-box;
  display: inline-flex;
  min-height: 58rpx;
  max-width: 100%;
  padding: 0 18rpx;
  border: 1rpx solid #dce4e1;
  border-radius: 999rpx;
  color: #596966;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(32, 43, 39, 0.08);
  align-items: center;
  gap: 10rpx;
}

.agent-process__spinner {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #b8c7c1;
  border-top-color: #245d4f;
  border-radius: 50%;
  animation: agent-process-spin 0.9s linear infinite;
}

.agent-process__label {
  min-width: 0;
  overflow: hidden;
  color: #4e5d5a;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-process__elapsed {
  flex: 0 0 auto;
  color: #929994;
  font-size: 24rpx;
  line-height: 36rpx;
}

.agent-process__chevron {
  flex: 0 0 auto;
  color: #7a8985;
}

.agent-process__details {
  box-sizing: border-box;
  margin: 12rpx 0 2rpx 18rpx;
  padding: 4rpx 0 2rpx 20rpx;
  border-left: 2rpx solid #d9e3df;
}

.agent-process__step {
  position: relative;
  display: flex;
  min-width: 0;
  padding: 8rpx 0;
  align-items: flex-start;
  gap: 14rpx;
}

.agent-process__step-marker {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #77948b;
}

.agent-process__step-marker--failed {
  background: #b86a5d;
}

.agent-process__step-content {
  min-width: 0;
}

.agent-process__step-summary,
.agent-process__step-detail {
  display: block;
  overflow-wrap: break-word;
  word-break: break-word;
}

.agent-process__step-summary {
  color: #576561;
  font-size: 24rpx;
  line-height: 34rpx;
}

.agent-process__step-detail {
  margin-top: 2rpx;
  color: #8a928e;
  font-size: 22rpx;
  line-height: 32rpx;
}

@keyframes agent-process-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.chat-message--user .chat-message__bubble {
  border-color: rgba(36, 93, 79, 0.18);
  border-radius: 20rpx 6rpx 20rpx 20rpx;
  color: #ffffff;
  background: #245d4f;
}

.chat-message--error .chat-message__bubble {
  border-color: rgba(174, 66, 66, 0.22);
  background: #fff7f5;
}

.chat-message__text {
  color: inherit;
  font-size: 29rpx;
  line-height: 1.68;
  overflow-wrap: break-word;
  word-break: break-word;
}

.chat-message__images {
  display: flex;
  max-width: 100%;
  margin-bottom: 14rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chat-message__image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.18);
}

.chat-message__pending {
  display: flex;
  height: 18rpx;
  margin-top: 14rpx;
  align-items: center;
  gap: 8rpx;
}

.pending-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8aa19a;
}

.draft-card {
  box-sizing: border-box;
  width: 650rpx;
  max-width: calc(100vw - 72rpx);
  margin-top: 14rpx;
  padding: 22rpx;
  border: 1rpx solid #d8e1dd;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(32, 43, 39, 0.08);
}

.draft-card__head {
  display: flex;
  min-height: 48rpx;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.draft-card__title {
  display: block;
  max-width: 430rpx;
  color: #232323;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  overflow-wrap: break-word;
}

.draft-card__revision {
  display: block;
  margin-top: 4rpx;
  color: #74726d;
  font-size: 22rpx;
  line-height: 30rpx;
}

.draft-card__status {
  flex: 0 0 auto;
  min-width: 88rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #245d4f;
  background: #e6f2ef;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.draft-card__status--confirmed {
  color: #22577a;
  background: #e5f0f7;
}

.draft-card__status--discarded {
  color: #8d3d32;
  background: #f8e9e6;
}

.draft-section {
  display: grid;
  margin-top: 20rpx;
  grid-template-columns: 78rpx minmax(0, 1fr);
  gap: 18rpx;
}

.draft-section__label {
  height: 42rpx;
  border-radius: 8rpx;
  color: #245d4f;
  background: #edf5f2;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-align: center;
}

.draft-section__body {
  min-width: 0;
}

.draft-section__title,
.draft-section__summary,
.draft-section__note,
.draft-section__avoid,
.draft-section__alt {
  display: block;
  overflow-wrap: break-word;
  word-break: break-word;
}

.draft-section__title {
  color: #232323;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 38rpx;
}

.draft-section__summary {
  margin-top: 6rpx;
  color: #3f4643;
  font-size: 26rpx;
  line-height: 38rpx;
}

.draft-section__note,
.draft-section__avoid,
.draft-section__alt {
  margin-top: 8rpx;
  color: #62605a;
  font-size: 24rpx;
  line-height: 36rpx;
}

.draft-section__avoid {
  color: #8d3d32;
}

.draft-section__alt {
  color: #22577a;
}

.draft-actions {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.draft-action {
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 12rpx;
  border: 1rpx solid #d8e1dd;
  border-radius: 8rpx;
  color: #245d4f;
  background: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.draft-action--primary {
  border-color: #245d4f;
  color: #ffffff;
  background: #245d4f;
}

.draft-action--danger {
  border-color: rgba(141, 61, 50, 0.26);
  color: #8d3d32;
  background: #fff7f5;
}

.draft-action[disabled] {
  color: #989690;
  background: #edf0ee;
}

.chat-bottom {
  height: 24rpx;
}

.advisor-chat__footer {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 16rpx 24rpx 34rpx;
  border-top: 1rpx solid #dfe5e2;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -18rpx 42rpx rgba(32, 43, 39, 0.08);
}

.advisor-chat__scenes {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.scene-chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(36, 93, 79, 0.18);
  border-radius: 999rpx;
  color: #245d4f;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(32, 43, 39, 0.05);
  font-size: 25rpx;
  font-weight: 500;
}

.scene-chip:active {
  background: #edf5f2;
  transform: scale(0.98);
}

.composer {
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #d8e1dd;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(32, 43, 39, 0.08);
}

.composer__input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-height: 42rpx;
  max-height: 180rpx;
  padding: 20rpx 22rpx 12rpx;
  color: #232323;
  caret-color: #245d4f;
  font-size: 29rpx;
  line-height: 42rpx;
  letter-spacing: 0;
}

.composer__actions {
  display: flex;
  padding: 0 18rpx 16rpx;
  align-items: center;
  justify-content: space-between;
}

.composer__image-button {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(36, 93, 79, 0.18);
  border-radius: 50%;
  color: #245d4f;
  background: #edf5f2;
  align-items: center;
  justify-content: center;
}

.composer__image-button::after,
.composer__submit::after {
  border: 0;
}

.composer__image-button[disabled] {
  color: #989690;
  background: #edf0ee;
}

.composer__submit {
  min-width: 96rpx;
  height: 60rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #245d4f;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.composer__submit[disabled] {
  color: #989690;
  background: #edf0ee;
}

.composer__submit--stop {
  color: #8d3d32;
  background: #fff0ec;
}
