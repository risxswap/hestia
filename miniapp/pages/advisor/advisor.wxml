<view class="page advisor-page advisor-chat">
  <scroll-view
    class="advisor-chat__list"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{scrollAnchor}}"
  >
    <view class="advisor-chat__content">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="chat-message chat-message--{{item.role}} {{item.status === 'error' ? 'chat-message--error' : ''}}"
      >
        <view class="chat-message__meta">{{item.role === 'user' ? '你' : 'Hestia'}}</view>
        <view wx:if="{{item.role === 'assistant' && item.process}}" class="agent-process">
          <view
            class="agent-process__summary"
            data-message-id="{{item.id}}"
            bind:tap="handleToggleProcess"
          >
            <view wx:if="{{item.process.status === 'running'}}" class="agent-process__spinner"></view>
            <text class="agent-process__label">{{item.process.summary}}</text>
            <text wx:if="{{item.process.elapsed_label}}" class="agent-process__elapsed">{{item.process.elapsed_label}}</text>
            <t-icon class="agent-process__chevron" name="{{item.process.expanded ? 'chevron-up' : 'chevron-right'}}" size="28rpx" />
          </view>
          <view wx:if="{{item.process.expanded && item.process.steps.length}}" class="agent-process__details">
            <view
              wx:for="{{item.process.steps}}"
              wx:for-item="step"
              wx:key="step_no"
              class="agent-process__step"
            >
              <view class="agent-process__step-marker agent-process__step-marker--{{step.status}}"></view>
              <view class="agent-process__step-content">
                <text class="agent-process__step-summary">{{step.summary}}</text>
                <text wx:if="{{step.detail}}" class="agent-process__step-detail">{{step.detail}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.content || (item.images && item.images.length)}}" class="chat-message__bubble">
          <view wx:if="{{item.images && item.images.length}}" class="chat-message__images">
            <image
              wx:for="{{item.images}}"
              wx:for-item="image"
              wx:key="url"
              class="chat-message__image"
              src="{{image.url}}"
              mode="aspectFill"
            />
          </view>
          <text wx:if="{{item.role === 'user'}}" class="chat-message__text">{{item.content}}</text>
          <t-chat-markdown wx:else class="chat-message__markdown" content="{{item.content}}" />
        </view>

        <view wx:if="{{item.draft}}" class="draft-card">
          <view class="draft-card__head">
            <view>
              <text class="draft-card__title">{{item.draft.scene_label || '形象建议草稿'}}</text>
              <text class="draft-card__revision">v{{item.draft.revision_no}}</text>
            </view>
            <text class="draft-card__status draft-card__status--{{item.draft.status}}">
              {{item.draft.status === 'confirmed' ? '已保存' : item.draft.status === 'discarded' ? '已丢弃' : '草稿'}}
            </text>
          </view>

          <view
            wx:for="{{item.draft.sections}}"
            wx:for-item="section"
            wx:key="public_id"
            class="draft-section"
          >
            <view class="draft-section__label">{{section.label}}</view>
            <view class="draft-section__body">
              <text class="draft-section__title">{{section.title}}</text>
              <text class="draft-section__summary">{{section.summary}}</text>
              <text wx:if="{{section.why_text}}" class="draft-section__note">{{section.why_text}}</text>
              <text wx:if="{{section.avoid_text}}" class="draft-section__avoid">{{section.avoid_text}}</text>
              <text wx:if="{{section.alternative_text}}" class="draft-section__alt">{{section.alternative_text}}</text>
            </view>
          </view>

          <view wx:if="{{item.draft.status === 'draft'}}" class="draft-actions">
            <button
              class="draft-action draft-action--primary"
              loading="{{item.draft.actionLoading}}"
              disabled="{{item.draft.actionLoading}}"
              data-draft-id="{{item.draft.draft_public_id}}"
              bind:tap="handleConfirmDraft"
            >确认</button>
            <button
              class="draft-action"
              disabled="{{item.draft.actionLoading || thinking}}"
              data-draft-id="{{item.draft.draft_public_id}}"
              bind:tap="handleContinueDraft"
            >继续调整</button>
            <button
              class="draft-action draft-action--danger"
              loading="{{item.draft.actionLoading}}"
              disabled="{{item.draft.actionLoading}}"
              data-draft-id="{{item.draft.draft_public_id}}"
              bind:tap="handleDiscardDraft"
            >丢弃</button>
          </view>
        </view>
      </view>
      <view id="chat-bottom" class="chat-bottom"></view>
    </view>
  </scroll-view>

  <view class="advisor-chat__footer" style="{{footerStyle}}">
    <scroll-view class="advisor-chat__scenes" scroll-x enable-flex>
      <view
        wx:for="{{quickScenes}}"
        wx:key="*this"
        class="scene-chip"
        data-scene="{{item}}"
        bind:tap="handleScene"
      >
        {{item}}
      </view>
    </scroll-view>

    <view class="composer">
      <textarea
        class="composer__input"
        value="{{inputValue}}"
        placeholder="输入场景、衣服或今天想呈现的感觉"
        disabled="{{thinking}}"
        auto-height
        confirm-type="send"
        adjust-position="{{false}}"
        maxlength="500"
        bindinput="handleInputChange"
        bindconfirm="handleSend"
        bindkeyboardheightchange="handleKeyboardHeightChange"
      />
      <view class="composer__actions">
        <button
          class="composer__image-button"
          disabled="{{thinking}}"
          aria-label="选择图片"
          bind:tap="handleChooseImage"
        >
          <t-icon name="image" size="32rpx" />
        </button>
        <button wx:if="{{thinking}}" class="composer__submit composer__submit--stop" bind:tap="handleStop">停止</button>
        <button wx:else class="composer__submit" disabled="{{!inputValue}}" bind:tap="handleSend">发送</button>
      </view>
    </view>
  </view>
</view>
